# Copy this file to ".env" and fill in your real values.
# Never commit the actual ".env" file to Git.

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=your_supabase_url

# Supabase API key. Use the "service_role" key (Project Settings -> API).
# This key bypasses Row Level Security and must NEVER be exposed to a
# browser/frontend - it is only ever read here, on the server.
SUPABASE_KEY=your_supabase_service_role_key

# Random secret used to sign Flask session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-this-secret
